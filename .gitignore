*.bak
*.bak.*
.DS_Store

# Machine-local and secret configuration
.zshrc.local
.env
.env.*
!.env.example
.direnv/

# Editor / tool state
.vscode/
.idea/
.zcompdump*

# Local terminal recordings
*.cast

# AI memory content and generated index are local by design.
# Keep the structure, rules, and tools in Git, but never commit personal notes.
ai-memory/.obsidian/
ai-memory/MEMORY-INDEX.md
ai-memory/user/*.md
ai-memory/environments/*.md
ai-memory/prefs/*.md
ai-memory/projects/*.md
ai-memory/reference/*.md
ai-memory/trivia/*.md
ai-memory/paths/*.md
ai-memory/archive/**
!ai-memory/archive/README.md
ai-memory/anarchy/**
!ai-memory/anarchy/README.md
ai-memory/scratch/**
!ai-memory/scratch/README.md

# pi coding agent local state. Only settings.json and models.json are tracked
# under .config/pi; credentials and session logs stay local.
.pi/agent/auth.json
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/sessions/

# Extension dependencies are installed by install.sh, not committed.
.config/pi/extensions/*/node_modules/
.config/pi/extensions/*/package-lock.json
.config/pi/extensions/*/pnpm-lock.yaml
